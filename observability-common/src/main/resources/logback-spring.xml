<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared logback config: opt in by adding observability-common to the service's pom.

  JSON output goes to stdout so Alloy/Loki can scrape without touching disk. Every MDC key set by
  TenantMdcFilter (tenant_id, project_id, shot_id, job_id, user_id, request_id) becomes a top
  level JSON field via LogstashEncoder, no custom pattern and no regex parsing on the Loki side.
  Keep the encoder default field names (timestamp, level, thread_name, logger_name, message,
  stack_trace); Grafana Loki plugin recognises them out of the box.

  Always JSON. An earlier version had an <if>/<then>/<else> switch driven by dalai.observability
  .log-json but that construct needs janino on the classpath at runtime, and pulling janino for
  a dev convenience is not worth the size. If a human needs a readable local tail, run the app
  outside Docker or pipe through `jq -R 'fromjson? | ...'`.
-->
<configuration>
    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="unknown-app"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <customFields>{"app":"${APP_NAME}"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
