    },
    {
      "name": "Post production (localhost:8181)",
      "description": "Everything owned by post-production-service under /v1/dubbing and /v1/post-production.",
      "item": [
        {
          "name": "Standalone dub -- upload video + target language (multipart)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "", "description": "video file to dub" },
                { "key": "targetLanguage", "type": "text", "value": "hi-IN" }
              ]
            },
            "url": { "raw": "{{postProdBase}}/v1/dubbing/jobs", "host": ["{{postProdBase}}"], "path": ["v1", "dubbing", "jobs"] },
            "description": "DubbingOrchestrator -- transcribe -> translate -> clone -> synth -> lip-sync -> mux. Fal.ai + ElevenLabs chain; both need their API keys set. Returns DubbingJobView with jobId, poll GET below."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const b = pm.response.json();",
                  "  if (b.id) pm.collectionVariables.set('dubbingJobId', b.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get dubbing job status",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{postProdBase}}/v1/dubbing/jobs/{{dubbingJobId}}", "host": ["{{postProdBase}}"], "path": ["v1", "dubbing", "jobs", "{{dubbingJobId}}"] }
          }
        },
        {
          "name": "Get dubbed video (302 to signed URL)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{postProdBase}}/v1/dubbing/jobs/{{dubbingJobId}}/video", "host": ["{{postProdBase}}"], "path": ["v1", "dubbing", "jobs", "{{dubbingJobId}}", "video"] }
          }
        },
        {
          "name": "List models (filter by type: lip_sync, tts, voice_clone, upscale, foley, music)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": {
              "raw": "{{postProdBase}}/v1/post-production/models?type=lip_sync",
              "host": ["{{postProdBase}}"],
              "path": ["v1", "post-production", "models"],
              "query": [{ "key": "type", "value": "lip_sync" }]
            },
            "description": "Every candidate registered for a capability -- lets you swap models per-request via voiceCloneModel/ttsModel/lipSyncModel overrides in the createJobs body."
          }
        },
        {
          "name": "Preview a voice profile (I want to hear it)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"text\": \"This is a preview of my cloned voice.\",\n  \"model\": null\n}" },
            "url": { "raw": "{{postProdBase}}/v1/post-production/voice-profiles/{{voiceProfileId}}/preview", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "voice-profiles", "{{voiceProfileId}}", "preview"] }
          }
        },
        {
          "name": "Generate foley (fal.ai)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sourceVideoUrl\": null,\n  \"cueDescription\": \"footsteps on wet pavement, distant thunder\",\n  \"model\": null\n}" },
            "url": { "raw": "{{postProdBase}}/v1/post-production/foley", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "foley"] }
          }
        },
        {
          "name": "Generate music (ElevenLabs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"moodPrompt\": \"warm cinematic strings, upbeat resolution\",\n  \"durationSeconds\": 15,\n  \"model\": null\n}" },
            "url": { "raw": "{{postProdBase}}/v1/post-production/music", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "music"] }
          }
        },
        {
          "name": "Upscale a video (fal-ai/topaz)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceVideoUrl\": \"https://media.dalaillama.in/creator-assets/video-gen-exports/some-shot.mp4\",\n  \"model\": null,\n  \"durationSeconds\": 5.0\n}"
            },
            "url": { "raw": "{{postProdBase}}/v1/post-production/upscale", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "upscale"] },
            "description": "Blocks until Topaz finishes. Duration required so llm-gateway can compute real cost. Falls back to configured default-upscale-model when model is null."
          }
        },
        {
          "name": "Create post-production jobs (SHOT or PROJECT scope)",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"scope\": \"SHOT\",\n  \"projectId\": \"{{projectId}}\",\n  \"shotRef\": \"{{shotRef}}\",\n  \"targetLanguage\": \"hi-IN\",\n  \"voiceCloneModel\": null,\n  \"ttsModel\": null,\n  \"lipSyncModel\": null\n}"
            },
            "url": { "raw": "{{postProdBase}}/v1/post-production/jobs", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "jobs"] },
            "description": "scope=SHOT: dub + lip-sync one shot. scope=PROJECT: every already-completed shot in the project. Blocks synchronously (same shape as video-gen approve)."
          }
        },
        {
          "name": "List post-production jobs for a project",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{postProdBase}}/v1/post-production/projects/{{projectId}}/jobs", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "projects", "{{projectId}}", "jobs"] }
          }
        },
        {
          "name": "Get post-production job video (302)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Tenant-ID", "value": "{{tenantId}}" }],
            "url": { "raw": "{{postProdBase}}/v1/post-production/jobs/{{jobId}}/video", "host": ["{{postProdBase}}"], "path": ["v1", "post-production", "jobs", "{{jobId}}", "video"] }
          }
        }
      ]
    }
  ]
}
