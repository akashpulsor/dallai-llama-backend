SERVICE_NAME=voice-brain
HOST=0.0.0.0
PORT=8601
LOG_LEVEL=INFO
DEBUG=false

# Public URL that PBX-Core or other services can use to reach this service.
AI_SERVICE_URL=http://voice-brain.default.svc.cluster.local:8601

# PBX-Core base URL used for AI config fetch, live transcript, sentiment, and escalation callbacks.
PBX_CORE_URL=http://pbx-core.default.svc.cluster.local:8080

# Postgres analytics store
DATABASE_URL=postgresql+asyncpg://voice_brain:change-me@postgres.default.svc.cluster.local:5432/voice_brain
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Auth / Keycloak
AUTH_ENABLED=false
AUTH_ALLOW_UNSAFE_DEV_TOKENS=false
KEYCLOAK_SERVER_URL=http://keycloak.default.svc.cluster.local
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_JWKS_URL=
KEYCLOAK_ISSUER=
KEYCLOAK_AUDIENCE=
KEYCLOAK_ALGORITHMS=RS256
KEYCLOAK_REQUIRED_SCOPES=

# Default providers used when PBX-Core config does not override them.
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_TTS_PROVIDER=deepgram
DEFAULT_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama
OLLAMA_BASE_URL=http://ollama.default.svc.cluster.local:11434/v1
OLLAMA_LLM_MODEL=gemma2:2b

# Google Vertex AI / Google Cloud
GOOGLE_API_KEY=
GOOGLE_PROJECT_ID=
GOOGLE_LOCATION=global
GOOGLE_CREDENTIALS_PATH=
GOOGLE_CREDENTIALS_JSON=
GOOGLE_LLM_MODEL=gemini-2.5-flash-lite
GOOGLE_GEMINI_LIVE_LLM_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_GEMINI_LIVE_VOICE=Charon
VERTEX_LLM_MODEL=gemma3-4b-it
GOOGLE_TTS_VOICE=hi-IN-Chirp3-HD-Pulcherrima
GOOGLE_TTS_VOICE_MALE=hi-IN-Chirp3-HD-Puck
GOOGLE_TTS_VOICE_FEMALE=hi-IN-Chirp3-HD-Pulcherrima
GOOGLE_TTS_MODE=chirp
GOOGLE_GEMINI_TTS_MODEL=gemini-2.5-flash-tts

# Deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_TTS_MODEL=aura-asteria-en



# RTP receiver for agent-call passive transcription (RTPEngine forks audio here)
VOICEBRAIN_RTP_PORT=5555

# Optional RVC
RVC_ENABLED=false
RVC_SERVER_URL=http://rvc.default.svc.cluster.local:8700
RVC_TIMEOUT_MS=100

# Founder-led avatar generation. When disabled or runner URL is empty, AI service
# returns a manual-approval response so creator-service can use Synthesia fallback.
AVATAR_GENERATION_ENABLED=false
AVATAR_GENERATION_RUNNER_URL=
AVATAR_GENERATION_RUNNER_PATH=/generate
AVATAR_VOICE_RUNNER_PATH=/voice
AVATAR_LIPSYNC_RUNNER_PATH=/lip-sync
AVATAR_STT_RUNNER_PATH=/stt
AVATAR_IMAGE_RUNNER_PATH=/image
AVATAR_POSTPROCESS_RUNNER_PATH=/postprocess-image
AVATAR_GENERATION_TIMEOUT_SECONDS=600
AVATAR_GENERATION_GPU_PROFILE=rtx_4060_8gb
AVATAR_VOICE_MODEL=fal_minimax_voice_clone
AVATAR_TALKING_MODEL=source_video
AVATAR_LIPSYNC_MODEL=fal_latentsync
AVATAR_IMAGE_MODEL=gemini_storyboard
AVATAR_LIGHTING_MODEL=ic_lightning
AVATAR_VIDEO_MODEL=ltx_video
AVATAR_PROPRIETARY_API_TIMEOUT_SECONDS=900
FAL_KEY=
AVATAR_FAL_VOICE_ENDPOINT=fal-ai/minimax/voice-clone
AVATAR_FAL_TTS_ENDPOINT=fal-ai/minimax/speech-02-hd
AVATAR_FAL_ECHOMIMIC_ENDPOINT=fal-ai/echomimic-v3
AVATAR_FAL_ECHOMIMIC_USD_PER_SECOND=0.20
AVATAR_FAL_HAPPY_HORSE_ENDPOINT=alibaba/happy-horse/v1.1/image-to-video
AVATAR_FAL_HAPPY_HORSE_720P_USD_PER_SECOND=0.14
AVATAR_FAL_HAPPY_HORSE_1080P_USD_PER_SECOND=0.18
AVATAR_FAL_HEYGEN_AVATAR4_ENDPOINT=fal-ai/heygen/avatar4/image-to-video
AVATAR_FAL_HEYGEN_AVATAR4_USD_PER_SECOND=0.10
AVATAR_FAL_LIVEPORTRAIT_ENDPOINT=fal-ai/live-portrait
AVATAR_FAL_LIPSYNC_ENDPOINT=fal-ai/latentsync
AVATAR_FAL_MUSETALK_ENDPOINT=fal-ai/musetalk
AVATAR_FAL_VIDEO_EDIT_ENDPOINT=fal-ai/kling-video/o1/standard/video-to-video/edit
AVATAR_FAL_VIDEO_EDIT_USD_PER_SECOND=0.126
AVATAR_FAL_MEDIA_EXPIRATION_SECONDS=3600
AVATAR_FAL_STORE_IO=false

# Dalai Llama local founder-avatar runtime. Enable this on the GPU worker when
# you want ai-service to run local models directly instead of forwarding to an
# external runner URL.
AVATAR_LOCAL_RUNTIME_ENABLED=false
AVATAR_MODEL_ROOT=./models/avatar
AVATAR_WORK_ROOT=./work/avatar
# Each client profile is stored as <root>/<profile-id>/voice.pth and voice.index.
# The current RTX 4060 worker can point this root at the packaged founder adapter.
AVATAR_RVC_PROFILE_ROOT=./models/avatar/rvc
AVATAR_RVC_DEFAULT_PROFILE_ID=founder_female_v1
AVATAR_RVC_APPLIO_ROOT=/home/kash/female-voice-clone-runtime/Applio
AVATAR_RVC_WSL_VENV=~/.venvs/indic-voice-benchmark
# Optional override. When blank, the bundled Windows/WSL-aware wrapper is used.
AVATAR_RVC_COMMAND=
AVATAR_DOWNLOAD_TIMEOUT_SECONDS=300
AVATAR_STAGE_TIMEOUT_SECONDS=1200
AVATAR_ALLOW_TEST_FALLBACK=false
AVATAR_COSYVOICE_REPO=
AVATAR_COSYVOICE2_MODEL_DIR=
AVATAR_COSYVOICE2_COMMAND=
AVATAR_ELEVENLABS_API_KEY=
AVATAR_ELEVENLABS_BASE_URL=https://api.elevenlabs.io
AVATAR_ELEVENLABS_VOICE_ID=
AVATAR_ELEVENLABS_MODEL_ID=eleven_multilingual_v2
AVATAR_ELEVENLABS_USD_PER_MILLION_CREDITS=30
AVATAR_ELEVENLABS_VOICE_COMMAND='python "scripts/run_elevenlabs_voice_clone.py" --text-file "{text_file}" --prompt-wav "{prompt_wav}" --output-audio "{output_audio}" --voice-id "{proprietary_voice_id}" --voice-name "{voice_clone_name}" --base-url "{elevenlabs_base_url}" --model-id "{elevenlabs_model_id}" --timeout "{proprietary_api_timeout_seconds}"'
AVATAR_VOICE_FALLBACK_COMMAND='python "scripts/run_elevenlabs_voice_clone.py" --text-file "{text_file}" --prompt-wav "{prompt_wav}" --output-audio "{output_audio}" --voice-id "{proprietary_voice_id}" --voice-name "{voice_clone_name}" --base-url "{elevenlabs_base_url}" --model-id "{elevenlabs_model_id}" --timeout "{proprietary_api_timeout_seconds}"'
AVATAR_LIVEPORTRAIT_REPO=
AVATAR_LIVEPORTRAIT_COMMAND='python "scripts/run_liveportrait_scene.py" --repo "{model_root}/LivePortrait" --source-video "{source_video}" --audio "{audio}" --output-video "{output_video}" --duration "{duration_seconds}"'
AVATAR_ECHOMIMIC_REPO=
AVATAR_ECHOMIMIC_COMMAND=
AVATAR_MUSETALK_REPO=
AVATAR_MUSETALK_COMMAND='python "scripts/run_musetalk_lipsync.py" --repo "{model_root}/MuseTalk" --input-video "{avatar_video}" --audio "{audio}" --output-video "{lip_synced_video}"'
AVATAR_LATENTSYNC_REPO=
AVATAR_LATENTSYNC_COMMAND='python "scripts/run_latentsync_lipsync.py" --repo "{model_root}/LatentSync" --input-video "{avatar_video}" --audio "{audio}" --output-video "{lip_synced_video}"'
AVATAR_SYNC_LABS_API_KEY=
AVATAR_SYNC_LABS_BASE_URL=https://api.sync.so
AVATAR_SYNC_LABS_MODEL=lipsync-2-pro
AVATAR_SYNC_LABS_COMMAND='python "scripts/run_sync_labs_lipsync.py" --input-video "{avatar_video}" --audio "{audio}" --output-video "{lip_synced_video}" --model "{sync_labs_model}" --base-url "{sync_labs_base_url}" --timeout "{proprietary_api_timeout_seconds}"'
AVATAR_LIPSYNC_FALLBACK_COMMAND='python "scripts/run_sync_labs_lipsync.py" --input-video "{avatar_video}" --audio "{audio}" --output-video "{lip_synced_video}" --model "{sync_labs_model}" --base-url "{sync_labs_base_url}" --timeout "{proprietary_api_timeout_seconds}"'
AVATAR_FLUX_MODEL_ID=black-forest-labs/FLUX.1-dev
AVATAR_FLUX_COMMAND=
AVATAR_STT_MODEL={model_root}/faster-whisper-tiny
AVATAR_STT_DEVICE=cpu
AVATAR_STT_COMPUTE_TYPE=int8
AVATAR_CAPTION_ENGINE=faster_whisper
AVATAR_WHISPERX_COMMAND=
AVATAR_BIREFNET_MODEL_ID=ZhengPeng7/BiRefNet
AVATAR_BIREFNET_COMMAND='python "scripts/run_birefnet_background_removal.py" --model-dir "{model_root}/BiRefNet" --input-image "{input_image}" --output-image "{output_image}"'
AVATAR_REALESRGAN_EXECUTABLE=
AVATAR_REALESRGAN_COMMAND=
AVATAR_REALESRGAN_MODEL=realesrgan-x4plus
AVATAR_CODEFORMER_REPO=
AVATAR_CODEFORMER_COMMAND='python "scripts/run_codeformer_face_restore.py" --repo "{model_root}/CodeFormer" --input-image "{input_image}" --output-image "{output_image}"'
AVATAR_VIDEO_BACKGROUND_REMOVAL_COMMAND=
AVATAR_VIDEO_UPSCALE_COMMAND=
AVATAR_VIDEO_FACE_RESTORE_COMMAND=

# Audio processing
SAMPLE_RATE=16000
AUDIO_NORMALIZE=true
AUDIO_TARGET_LUFS=-16.0
AUDIO_HIGHPASS_HZ=80
AUDIO_LIMITER_THRESHOLD=0.95
