VB_SERVICE_NAME=voice-brain
VB_HOST=0.0.0.0
VB_PORT=8601
VB_LOG_LEVEL=INFO
VB_DEBUG=false

# Public URL that PBX-Core or other services can use to reach this service.
VB_SERVICE_PUBLIC_URL=http://voice-brain.default.svc.cluster.local:8601

# PBX-Core base URL used for AI config fetch, live transcript, sentiment, and escalation callbacks.
VB_PBX_CORE_URL=http://pbx-core.default.svc.cluster.local:8080

# Postgres analytics store
VB_DATABASE_URL=postgresql+asyncpg://voice_brain:change-me@postgres.default.svc.cluster.local:5432/voice_brain
VB_DB_ECHO=false
VB_DB_POOL_SIZE=10
VB_DB_MAX_OVERFLOW=20

# Default providers used when PBX-Core config does not override them.
VB_DEFAULT_STT_PROVIDER=deepgram
VB_DEFAULT_TTS_PROVIDER=deepgram
VB_DEFAULT_LLM_PROVIDER=openai

# OpenAI
VB_OPENAI_API_KEY=
VB_OPENAI_STT_MODEL=whisper-1
VB_OPENAI_TTS_MODEL=tts-1
VB_OPENAI_TTS_VOICE=alloy
VB_OPENAI_LLM_MODEL=gpt-4o-mini

# Ollama
VB_OLLAMA_BASE_URL=http://ollama.default.svc.cluster.local:11434/v1
VB_OLLAMA_LLM_MODEL=gemma2:2b

# Deepgram
VB_DEEPGRAM_API_KEY=
VB_DEEPGRAM_STT_MODEL=nova-2
VB_DEEPGRAM_TTS_MODEL=aura-asteria-en

# Optional local Indic TTS
VB_INDIC_TTS_BASE_URL=http://indic-tts.default.svc.cluster.local:5005/synthesize
VB_INDIC_TTS_SAMPLE_RATE=16000
VB_INDIC_TTS_VOICE=female
VB_INDIC_TTS_EMOTION=neutral

# Optional RVC
VB_RVC_ENABLED=false
VB_RVC_SERVER_URL=http://rvc.default.svc.cluster.local:8700
VB_RVC_TIMEOUT_MS=100

# Audio processing
VB_SAMPLE_RATE=16000
VB_AUDIO_NORMALIZE=true
VB_AUDIO_TARGET_LUFS=-16.0
VB_AUDIO_HIGHPASS_HZ=80
VB_AUDIO_LIMITER_THRESHOLD=0.95
