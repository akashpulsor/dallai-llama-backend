<!--
  HOW FREESWITCH CONNECTS TO VOICE-BRAIN
  
  This goes in the tenant dialplan XML (generated by PBX-Core during provisioning
  and served via mod_xml_curl GET /internal/freeswitch/dialplan).
  
  FreeSWITCH reads X-Tenant-ID, X-Product-Code headers from Kamailio
  and passes them to voice-brain as WebSocket query params.
  
  voice-brain runs on the SAME bare-metal server: ws://127.0.0.1:8600
  OR in K8s via Traefik: ws://voice-brain.telecom.svc.cluster.local:8600
-->

<!-- Example: Conversational IVR — bot handles entire call -->
<extension name="conversational_ivr">
  <condition field="${sip_h_X-Product-Code}" expression="CONV_IVR">
    <action application="answer"/>
    <action application="set" data="RECORD_STEREO=true"/>
    <!-- Connect audio bidirectionally to voice-brain -->
    <action application="socket" 
            data="ws://127.0.0.1:8600/audio/${uuid}?tenant_id=${sip_h_X-Tenant-ID}&amp;product_code=CONV_IVR&amp;bot_id=${sip_h_X-Bot-ID}&amp;direction=INBOUND"/>
    <!-- If voice-brain disconnects or escalates, call continues to next action -->
    <action application="playback" data="silence_stream://1000"/>
  </condition>
</extension>

<!-- Example: AI Contact Center — bot listens, agent talks, live transcript -->
<extension name="ai_contact_center">
  <condition field="${sip_h_X-Product-Code}" expression="AI_CC">
    <action application="answer"/>
    <!-- Fork audio to voice-brain for STT + intent + sentiment (one-way listen) -->
    <action application="set" data="media_bug_answer_req=true"/>
    <action application="record_session" 
            data="ws://127.0.0.1:8600/audio/${uuid}?tenant_id=${sip_h_X-Tenant-ID}&amp;product_code=AI_CC&amp;direction=INBOUND"/>
    <!-- Bridge to agent (Kamailio delivers to registered SIP.js) -->
    <action application="bridge" data="sofia/internal/${sip_h_X-Routing-Target}"/>
  </condition>
</extension>

<!-- Example: Basic PBX — transcript only if stt_enabled -->
<extension name="basic_pbx_with_stt">
  <condition field="${sip_h_X-Product-Code}" expression="BASIC_PBX">
    <condition field="${sip_h_X-AI-Enabled}" expression="true">
      <action application="set" data="media_bug_answer_req=true"/>
      <action application="record_session" 
              data="ws://127.0.0.1:8600/audio/${uuid}?tenant_id=${sip_h_X-Tenant-ID}&amp;product_code=BASIC_PBX"/>
    </condition>
    <!-- Normal PBX routing -->
    <action application="bridge" data="sofia/internal/${sip_h_X-Routing-Target}"/>
  </condition>
</extension>
